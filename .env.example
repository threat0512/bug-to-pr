# =============================================================================
# Bug to PR - Environment Configuration
# =============================================================================

# AI Service Configuration
# Provider Selection: groq | hf_inference_api
AI_PROVIDER=hf_inference_api

# Groq Configuration (when AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=deepseek-r1-distill-llama-70b
GROQ_TEMPERATURE=0.3

# HuggingFace Inference Providers Configuration (when AI_PROVIDER=hf_inference_api)
HF_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
HF_API_KEY=your_hf_token_here   # Get from https://huggingface.co/settings/tokens (fine-grained token)
HF_MAX_NEW_TOKENS=512
HF_TEMPERATURE=0.7             # Qwen3 recommended temperature
HF_TIMEOUT_MS=60000

# Service URLs
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Service Ports
AI_SERVICE_PORT=8000
BACKEND_PORT=3001

# AI Service Server Configuration
AI_SERVICE_HOST=0.0.0.0

# =============================================================================
# Production Deployment Examples
# =============================================================================
# Uncomment and update these for production deployment:

# AI_SERVICE_URL=https://your-ai-service-domain.com
# BACKEND_URL=https://your-backend-domain.com
# FRONTEND_URL=https://your-frontend-domain.com

# =============================================================================
# Environment Variables Reference
# =============================================================================
# AI_PROVIDER: LLM provider to use (groq | hf_transformers, default: groq)

# Groq Provider:
# GROQ_API_KEY: Required when using Groq - Get from https://groq.com
# GROQ_MODEL: Optional - Groq model name (default: deepseek-r1-distill-llama-70b)
# GROQ_TEMPERATURE: Optional - AI creativity (0.0-1.0, default: 0.3)

# HuggingFace Transformers Provider (Local Inference):
# HF_MODEL_ID: Model ID on HuggingFace (default: deepseek-ai/deepseek-coder-6.7b-instruct)
# HF_MAX_NEW_TOKENS: Maximum tokens to generate (default: 512)
# HF_TEMPERATURE: AI creativity (0.0-1.0, default: 0.2)
# HF_USE_QUANTIZATION: Use 4-bit quantization for GPU memory efficiency (default: true)
# HF_CACHE_DIR: Optional - Custom directory for model cache

# Service Configuration:
# AI_SERVICE_URL: Backend calls this to generate PR plans
# BACKEND_URL: Frontend calls this for API requests
# FRONTEND_URL: For reference (not used by services)
# AI_SERVICE_PORT: AI service port (default: 8000)
# BACKEND_PORT: Backend service port (default: 3001)
# GITHUB_TOKEN: Optional - For higher GitHub API rate limits
# AI_SERVICE_HOST: AI service host (default: 0.0.0.0)

# =============================================================================
# Hardware Requirements
# =============================================================================
# HuggingFace Transformers Provider:
# - Minimum: 8GB RAM (CPU inference)
# - Recommended: 6GB+ GPU VRAM with CUDA (with quantization)
# - Optimal: 12GB+ GPU VRAM (without quantization)
# 
# Model will automatically:
# - Use CUDA if available and sufficient VRAM
# - Use Apple Silicon MPS if on Mac
# - Fall back to CPU if no GPU available